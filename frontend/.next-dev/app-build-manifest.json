      "static/chunks/main-app.js",
      "static/chunks/app/api/proxy/[...apiPath]/route.js"
    ],
    "/sinkhole/dnssinkhole/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/sinkhole/dnssinkhole/page.js"
