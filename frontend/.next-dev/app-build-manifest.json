    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/sinkhole/dnssinkhole/[domain]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/sinkhole/dnssinkhole/[domain]/page.css",
      "static/chunks/app/sinkhole/dnssinkhole/[domain]/page.js"
    ],
    "/api/proxy/[...apiPath]/route": [
